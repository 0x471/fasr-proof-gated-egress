#!/bin/sh
# Starts the endpoint at boot as the unprivileged user pge; the log goes to tmpfs.
DAEMON=/usr/bin/pge-endpoint
PIDFILE=/var/run/endpoint.pid
# The model and the release policy come from the signed update store on the data partition.
ARGS="--listen 192.168.2.2:8700 --server 192.168.2.1:8701 --store /data/pge-store --root /etc/pge/root.pub \
--device pi-1 --log /var/log/endpoint.log"

case "$1" in
	start)
		printf "Starting endpoint: "
		/usr/sbin/nft list table ip pge >/dev/null 2>&1 || { echo "FAIL (no firewall)"; exit 1; }
		start-stop-daemon -S -b -m -p "$PIDFILE" -c pge -x "$DAEMON" -- $ARGS && echo OK || echo FAIL
		;;
	stop)
		printf "Stopping endpoint: "
		start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE" && echo OK || echo FAIL
		;;
	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
